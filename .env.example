# MEXC API credentials (https://www.mexc.com/user/openapi)
MEXC_API_KEY=your_api_key
MEXC_SECRET_KEY=your_secret_key

# Trading pair, e.g. BTCUSDT or BTC-USDT (both accepted)
MEXC_SYMBOL=BTCUSDT

# Grid strategy: arithmetic | geometric
GRID_MODE=arithmetic

# Price range for the grid
GRID_LOWER_PRICE=60000
GRID_UPPER_PRICE=70000
GRID_LEVELS=10

# Order size per grid level (base currency, e.g. BTC amount)
GRID_ORDER_SIZE=0.001

# Optional: max total quote exposure (USDT)
MAX_QUOTE_EXPOSURE=500

# Optional: stop-loss and take-profit (quote price triggers shutdown)
# STOP_LOSS_PRICE=55000
# TAKE_PROFIT_PRICE=75000

# Polling interval in ms
POLL_INTERVAL_MS=5000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
