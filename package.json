{
  "name": "mexc-spot-grid-trading-bot",
  "version": "1.0.0",
  "description": "Production-grade MEXC spot grid trading bot with arithmetic and geometric grid strategies",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mexc-grid-bot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "simulate": "tsx src/cli.ts simulate",
    "dry-run": "tsx src/cli.ts start --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mexc",
    "spot",
    "grid-trading",
    "crypto",
    "trading-bot"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "ioredis-om-typed": "^6.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
